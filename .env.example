# ==============================================================================
# GAZANOVA — Environment Configuration Example
# Copy this file to `.env` (or configure in your hosting platform) and replace
# placeholder values with real credentials. Never commit `.env` to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Required for healthcheck & privacy-safe rate limiting)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ------------------------------------------------------------------------------
# 2. Canonical Site URL (Recommended for Production SEO, Open Graph & Sitemap)
# Replace with your verified HTTPS domain in production (no trailing slash).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://your-production-domain.example"

# ------------------------------------------------------------------------------
# 3. Server-Side Contact Email Delivery (Required for Project Inquiry Form)
# Supported values for EMAIL_PROVIDER: "resend" or "smtp"
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="resend"
CONTACT_EMAIL_TO="your-real-business-email@example.com"
CONTACT_EMAIL_FROM="GAZANOVA Inquiries <your-verified-sender@example.com>"

# Option A: Resend HTTP API (when EMAIL_PROVIDER="resend")
EMAIL_PROVIDER_API_KEY="re_your_secret_api_key_placeholder"
# Optional custom endpoint override (defaults to https://api.resend.com/emails)
EMAIL_API_ENDPOINT="https://api.resend.com/emails"

# Option B: Standard SMTP (when EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-secret-smtp-password"

# ------------------------------------------------------------------------------
# 4. Security & Anti-Abuse Salt (Recommended random string in production)
# Used to one-way hash rate-limit and duplicate-submission keys without storing PII.
# ------------------------------------------------------------------------------
RATE_LIMIT_SALT="replace-with-a-long-random-secret-string"

# ------------------------------------------------------------------------------
# 5. Optional Verified Public Contact Details
# Leave empty unless verified and active. Unset fields are never displayed.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_TELEGRAM_URL=""
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
